opt_out_usage

default_platform(:ios)

require_relative "lib/pubspec_version"

# Path constants (relative to the repo root; fastlane runs from fastlane/).
WORKSPACE       = "ios/Runner.xcworkspace"
XCODEPROJ       = "ios/Runner.xcodeproj"
SCHEME          = "Runner"
APP_IDENTIFIER  = "com.cedricziel.trueapp"
TEAM_ID         = "WPW3QSLZ2F"
OUTPUT_DIR      = "build"
IPA_NAME        = "TrueNASManager.ipa"
MATCH_PROFILE   = "match AppStore #{APP_IDENTIFIER}"

# Build number = number of commits reachable from HEAD. Reproducible from git
# state alone — never committed back to pubspec.yaml.
def commit_count_build_number
  @commit_count_build_number ||= sh("git rev-list --count HEAD", log: false).strip
end

# Marketing version = pubspec.yaml `version:` without the +build suffix.
# release-please bumps it; nothing here writes to it.
def marketing_version
  @marketing_version ||= PubspecVersion.read(File.expand_path("../pubspec.yaml", __dir__))
end

before_all do |lane, options|
  Dotenv.load(".env") if File.exist?(".env")
  # Without setup_ci, codesign on macOS runners hangs forever waiting for
  # an interactive keychain unlock. setup_ci creates a temp keychain,
  # imports certs, and blesses the private key for non-interactive use.
  setup_ci if is_ci
end

# ---------------------------------------------------------------------------
# Public lanes
# ---------------------------------------------------------------------------

desc "Build a signed App Store IPA without uploading (sanity check)"
lane :build do
  build_ios
end

desc "Build and push a new beta build to TestFlight"
lane :beta do |options|
  ensure_git_status_clean unless options[:allow_dirty]
  api_key = build_ios

  upload_to_testflight(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    skip_waiting_for_build_processing: true,
    changelog: options[:changelog] || "Beta build #{Time.now.strftime('%Y-%m-%d %H:%M')}"
  )
  # dSYMs are bundled in the IPA via build_app's include_symbols:true and
  # App Store Connect extracts them automatically — no separate upload step.
end

desc "Sync signing certificates and provisioning profiles via match (readonly by default)"
lane :sync_signing do |options|
  api_key = load_app_store_connect_api_key
  match(type: options[:type] || "appstore", readonly: options[:readonly] != false, api_key: api_key)
end

desc "Bootstrap signing — creates the App Store profile in the match repo. Run once."
lane :bootstrap_signing do
  api_key = load_app_store_connect_api_key
  match(type: "appstore", readonly: false, api_key: api_key)
end

desc "Print the version and build number that would be used"
lane :show_build_number do
  UI.message("Version: #{marketing_version}  Build: #{commit_count_build_number}")
end

# ---------------------------------------------------------------------------
# Private lanes / helpers
# ---------------------------------------------------------------------------

desc "match + Flutter build + xcodebuild archive. Returns the ASC API key."
private_lane :build_ios do
  api_key = load_app_store_connect_api_key
  sync_code_signing(type: "appstore", readonly: is_ci, api_key: api_key)

  # Flutter's Runner target uses automatic signing, which needs an
  # interactive Apple ID session. Switch to manual signing with the profile
  # match just installed so xcodebuild can sign headlessly.
  update_code_signing_settings(
    use_automatic_signing: false,
    path: XCODEPROJ,
    team_id: TEAM_ID,
    code_sign_identity: "iPhone Distribution",
    profile_name: ENV["sigh_#{APP_IDENTIFIER}_appstore_profile-name"] || MATCH_PROFILE,
    targets: [SCHEME]
  )

  # Compile Dart and stage assets; signing happens in build_app below.
  # --build-name/--build-number land in Flutter/Generated.xcconfig, which
  # the Xcode project reads as MARKETING_VERSION / CURRENT_PROJECT_VERSION.
  Dir.chdir("..") do
    sh(
      "flutter", "build", "ios", "--release", "--no-codesign",
      "--build-name=#{marketing_version}",
      "--build-number=#{commit_count_build_number}"
    )
  end

  build_app(
    workspace: WORKSPACE,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: OUTPUT_DIR,
    output_name: IPA_NAME,
    include_symbols: true,
    include_bitcode: false,
    destination: "generic/platform=iOS",
    export_options: {
      provisioningProfiles: { APP_IDENTIFIER => MATCH_PROFILE }
    }
  )

  api_key
end

# Loads an App Store Connect API key from one of:
#   - ASC_KEY_PATH        : filesystem path to the .p8 file
#   - ASC_KEY_CONTENT     : raw or base64-encoded contents of the .p8 file
#
# Required env vars: ASC_KEY_ID, ASC_ISSUER_ID
def load_app_store_connect_api_key
  return @asc_api_key if @asc_api_key

  # fastlane auto-loads fastlane/.env.default, whose placeholder entries
  # yield empty strings — treat those as unset.
  env = ->(name) {
    value = ENV[name]
    value.nil? || value.strip.empty? ? nil : value
  }
  key_id      = env.call("ASC_KEY_ID")
  issuer_id   = env.call("ASC_ISSUER_ID")
  key_path    = env.call("ASC_KEY_PATH")
  key_content = env.call("ASC_KEY_CONTENT")

  if key_id.nil? || issuer_id.nil? || (key_path.nil? && key_content.nil?)
    UI.user_error!(<<~MSG)
      Missing App Store Connect API key configuration. Set:
        ASC_KEY_ID         (e.g. ABC123XYZ9)
        ASC_ISSUER_ID      (UUID from appstoreconnect.apple.com -> Users and Access -> Keys)
        ASC_KEY_PATH       (path to .p8 file)  OR  ASC_KEY_CONTENT (raw or base64)

      Locally: copy fastlane/.env.default to fastlane/.env and fill in.
      In CI:   configure these as GitHub Actions secrets.
    MSG
  end

  # fastlane >= 2.235 rejects key_filepath and key_content together,
  # even when one of them is nil — pass exactly one.
  params = { key_id: key_id, issuer_id: issuer_id, in_house: false }
  if key_path
    params[:key_filepath] = key_path
  else
    params[:key_content] = key_content
    params[:is_key_content_base64] =
      key_content.match?(/\A[A-Za-z0-9+\/=\s]+\z/) && !key_content.include?("BEGIN PRIVATE KEY")
  end
  @asc_api_key = app_store_connect_api_key(**params)
end

error do |lane, exception|
  UI.error("Lane #{lane} failed: #{exception.message}")
end
